# Stripe (Developers → API keys). Use the sk_test_ key until launch.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# Optional. Set to "off" to start checkout without Stripe Tax (only while
# tax settings are incomplete in a sandbox).
# STRIPE_AUTOMATIC_TAX=off

# Optional. Defaults to the request origin.
# NEXT_PUBLIC_SITE_URL=https://www.constelier.com

# Orders database. Unset = no database (orders are only logged).
# Production: set by Vercel's Neon integration. Local dev:
# DATABASE_URL=pglite:./.data/pglite

# Design thumbnails in Vercel Blob. Set by Vercel's Blob integration.
# BLOB_READ_WRITE_TOKEN=

# Optional. Error alerts are always logged; set this to a Slack or Discord
# incoming-webhook URL to also get them there.
# ALERT_WEBHOOK_URL=

# Optional, local dev only: the lab's photo renders (Blender on Modal, see
# tools/blender/README.md). Key and secret are a Modal proxy auth token.
# RENDER_API_URL=https://<workspace>--constelier-renders-api.us-east.modal.run
# RENDER_API_KEY=
# RENDER_API_SECRET=

# ── Quote requests and the admin panel (docs/quotes-admin.md) ──────────────

# Switches on /admin. At least 12 characters; changing it signs everyone out.
# ADMIN_PASSWORD=

# Production only: lets the admin panel on the live site show staging's data.
# Set by connecting the staging Neon store to Production with the prefix
# STAGING (Vercel → Storage), or pasted by hand.
# STAGING_DATABASE_URL=
# Optional. Where staging's pendant pages live. Defaults to https://staging.constelier.com
# STAGING_SITE_URL=

# Email (Twilio SendGrid). The from address must be on a domain authenticated
# in SendGrid. Replies to reply+<customer>@MESSAGE_REPLY_DOMAIN come back
# through Inbound Parse, whose webhook URL carries INBOUND_EMAIL_SECRET.
# SENDGRID_API_KEY=
# MESSAGE_FROM_EMAIL=hello@mail.constelier.com
# MESSAGE_FROM_NAME=Constelier
# MESSAGE_REPLY_DOMAIN=mail.constelier.com
# INBOUND_EMAIL_SECRET=

# Texts (Twilio). Use the number, or a Messaging Service if you have one.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15555550123
# TWILIO_MESSAGING_SERVICE_SID=

# Outside production, messages only go to these (comma-separated emails and
# phone numbers). Leave unset and nothing can be sent from staging or a laptop.
# MESSAGE_ALLOWLIST=you@example.com,+15555550123
