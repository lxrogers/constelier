# Shows the "Add to bag" step and bag link instead of the waitlist.
NEXT_PUBLIC_SHOP_ENABLED=true

# Stripe (Developers → API keys). Use the sk_test_ key until launch.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# Optional. Set to "off" to start checkout without Stripe Tax (only while
# tax settings are incomplete in a sandbox).
# STRIPE_AUTOMATIC_TAX=off

# Optional. Defaults to the request origin.
# NEXT_PUBLIC_SITE_URL=https://www.constelier.com

# Orders database. Unset = no database (orders are only logged).
# Production: set by Vercel's Neon integration. Local dev:
# DATABASE_URL=pglite:./.data/pglite

# Design thumbnails in Vercel Blob. Set by Vercel's Blob integration.
# BLOB_READ_WRITE_TOKEN=

# Optional. Error alerts are always logged; set this to a Slack or Discord
# incoming-webhook URL to also get them there.
# ALERT_WEBHOOK_URL=
